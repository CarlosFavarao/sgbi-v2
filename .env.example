# API de views do BI
API_VIEW="http://host:porta"

# MySQL 5.7
DB_HOST=""
DB_PORT=3306
DB_USER=""
DB_PASSWORD=""
DB_DATABASE=""

# Assina o cookie de sessão do login (D45). Obrigatório, mínimo 32 caracteres,
# um valor por instalação: openssl rand -base64 32
JWT_SECRET=""

# Opcional: identifica a instalação quando há mais de um SGBI no mesmo endereço
# (ex.: portas diferentes no mesmo servidor), para cada um ter o próprio cookie.
CLIENT_SLUG=""

# Opcional, para testes: força a plataforma (vx, cloud ou fivewin) no lugar da
# que o login do VX informa e mostra os cards que ficam indisponíveis nela (D46).
PLATAFORMA=""
